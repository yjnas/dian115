{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/plugin-platform/market-index.schema.json",
  "title": "DIAN115 Plugin Market Index v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "repository", "plugins"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "plugins": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "apiPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "reason"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/api/[A-Za-z0-9._~:/{}?=&-]+$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "networkPermission": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "reason"],
      "properties": {
        "origin": { "type": "string", "pattern": "^https?://[^/]+$" },
        "methods": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "default": ["GET"], "items": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] } },
        "proxy_mode": { "type": "string", "enum": ["direct", "system", "required"], "default": "system" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "runtimeDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol", "autostart", "trust_level"],
      "properties": {
        "kind": { "enum": ["process", "wasm"] },
        "protocol": { "enum": ["dian115:process@1", "dian115:wasm@1"] },
        "autostart": { "type": "boolean" },
        "trust_level": { "enum": ["isolated-process", "wasm-sandbox"] }
      },
      "allOf": [{
        "properties": {
          "autostart": { "const": true }
        }
      }]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "version", "package_url", "sha256", "runtime", "permissions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "description": { "type": "string", "maxLength": 2000 },
        "author": { "type": "string", "maxLength": 120 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "icon_url": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https://" },
            {
              "type": "string",
              "format": "uri-reference",
              "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//).+"
            }
          ]
        },
        "package_url": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https://" },
            {
              "type": "string",
              "format": "uri-reference",
              "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//).+"
            }
          ]
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime": { "$ref": "#/$defs/runtimeDisclosure" },
        "permissions": {
          "type": "object", "additionalProperties": false,
          "required": ["apis"],
          "properties": {
            "apis": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/apiPermission" } },
            "network": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/networkPermission" } }
          }
        },
        "capabilities": false,
        "account_access": false,
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 40 }
        }
      }
    }
  }
}
